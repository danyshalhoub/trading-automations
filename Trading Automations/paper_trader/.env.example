# Alpaca paper trading credentials (paper=True is hardcoded in trader.py)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Gmail address to send/receive the weekly performance digest.
# GMAIL_APP_PASSWORD must be a Gmail "app password" (Google Account ->
# Security -> 2-Step Verification -> App passwords), not your real password.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Used by weekly_tournament.py to generate new candidate strategy parameters
# each Friday (Claude Opus 4.8, structured JSON output only — no code
# generation). Optional: if unset, the weekly tournament still re-tests the
# current 4 live strategies against fresh data, it just won't propose new
# candidates that week. Typical cost: a few cents to ~20 cents/week.
ANTHROPIC_API_KEY=
